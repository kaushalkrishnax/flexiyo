# .env.example — copy to .env and fill in values
# Cloudflare Worker Secrets
# Set via: wrangler secret put JWT_SECRET
# Generate a strong random 32-byte secret:
#   openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# Wrangler Configuration
# D1 database ID — obtained after running:
#   wrangler d1 create flexiyo-db
# Then copy the database_id from the output and paste it in wrangler.toml
D1_DATABASE_ID=REPLACE_WITH_REAL_D1_DATABASE_ID

# CORS
# Allowed origin for API requests (comma-separated if multiple)
CORS_ORIGIN=https://flexiyo.kaushalkrishnax.workers.dev

# In-app updater
# GitHub owner/repo that publishes release APKs checked by /api/update/check.
# The APK asset names must match app-<abi>-release.apk (e.g. app-arm64-v8a-release.apk).
UPDATE_GITHUB_REPO=kaushalkrishnax/flexiyo

# Push notifications (Android via Firebase Cloud Messaging)
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the entire JSON as the secret value:
#   wrangler secret put FCM_SERVICE_ACCOUNT
# Without this secret, notifications are skipped and chat keeps working.
FCM_SERVICE_ACCOUNT=REPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_JSON

# Flutter / Local Development
# Override API base URL at build time:
#   flutter run --dart-define=API_BASE_URL=http://localhost:8787
# Default is the production Worker URL (see lib/core/constants.dart)

# Notes
# JWT_SECRET must be set as a Wrangler secret (not a var) so it never appears
# in wrangler.toml or source control:
#   wrangler secret put JWT_SECRET
# You will be prompted to enter the value interactively.
