{
  "name": "flexiyo-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate:local": "wrangler d1 migrations apply flexiyo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flexiyo-db --remote",
    "db:seed:local": "wrangler d1 execute flexiyo-db --local --file=./migrations/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "itty-router": "^5.0.18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^5.20261013.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9",
    "wrangler": "^4.35.0"
  }
}
