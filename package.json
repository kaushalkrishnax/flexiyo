{
  "name": "flexiyo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cd functions && bunx wrangler dev",
    "test": "cd functions && bunx vitest run",
    "test:watch": "cd functions && bunx vitest",
    "type-check": "cd functions && bunx tsc --noEmit",
    "db:migrate:local": "bunx wrangler d1 migrations apply flexiyo-db --local",
    "db:migrate:remote": "bunx wrangler d1 migrations apply flexiyo-db --remote",
    "deploy": "bunx wrangler deploy",
    "release:android": "node scripts/build-release.js --platform android",
    "release:ios": "node scripts/build-release.js --platform ios",
    "bump:beta": "node scripts/bump.js --beta",
    "bump:release": "node scripts/bump.js --release"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
